# StayFlow Hotel Management System - Backend Environment Configuration

APP_NAME=StayFlow Hotel API
APP_ENV=production

# -------------------------------------------------------------
# Database Configuration (Railway MySQL / PostgreSQL or Local)
# -------------------------------------------------------------
# On Railway, adding a MySQL or PostgreSQL plugin automatically provides:
# MYSQL_URL, DATABASE_URL, or MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE.
# The application automatically detects and uses them with pymysql/psycopg2!
DATABASE_URL=mysql+pymysql://root:password@mysql.railway.internal:3306/railway

# -------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------
# Secret key for signing JWT tokens (at least 32 characters)
JWT_SECRET_KEY=bHVDJ88Y1uBTOhO8uIsO2k13B1mtmUbSHv18MqV8xrvdbmVK232_iV_Jd0HvcIeG
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# -------------------------------------------------------------
# CORS Configuration
# -------------------------------------------------------------
# Set this to your Vercel frontend URL(s) (comma-separated):
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# Configured Production Frontend Domain / URL for QR Codes & Public Guest Portals
FRONTEND_URL=https://your-frontend-app.vercel.app

# -------------------------------------------------------------
# Webhook Security
# -------------------------------------------------------------
WEBHOOK_SECRET=stayflow_whsec_production_secret_key_2026

